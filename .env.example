# ResearchMate Environment Variables Template

# Database Settings (MySQL)
DB_URL=jdbc:mysql://localhost:3306/researchmate?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# JWT Security
JWT_SECRET=your_super_secret_jwt_key_at_least_256_bits_long_for_hmac_sha256
JWT_EXPIRATION=86400000

# File Storage
UPLOAD_DIR=uploads/papers

# AI / LLM Integration (Optional - Falls back to deterministic extraction if blank)
LLM_API_KEY=
LLM_ENDPOINT=https://api.openai.com/v1/chat/completions

# Semantic Embeddings (Optional - Falls back to dense subword projection if blank)
EMBEDDING_API_KEY=
